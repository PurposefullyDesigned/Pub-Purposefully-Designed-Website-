/* ===== RESET & BASE ===== */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: Inter, sans-serif;
  background: #f3f7fa;
  color: #3a4a55;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* ===== SKIP LINK ===== */
.skip-link {
  position: absolute;
  top: -9999px;
  left: 1rem;
  background: #5fb8c4;
  color: #fff;
  padding: 0.5rem 1rem;
  border-radius: 0 0 0.25rem 0.25rem;
  z-index: 1000;
  text-decoration: none;
  font-weight: 600;
}
.skip-link:focus { top: 0; }

/* ===== TAGLINE BANNER ===== */
.tagline-banner {
  background: linear-gradient(90deg, #6b3fa0, #5fb8c4);
  color: #fff;
  text-align: center;
  padding: 0.45rem 1rem;
  font-size: 0.875rem;
  font-weight: 500;
  letter-spacing: 0.04em;
  position: sticky;
  top: 0;
  z-index: 50;
}

/* ===== SITE HEADER ===== */
.site-header {
  position: sticky;
  top: 2.1rem; /* just below tagline */
  z-index: 40;
  background: rgba(243, 247, 250, 0.9);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid #d8e3eb;
}
.site-header .container {
  max-width: 80rem;
  margin: 0 auto;
  padding: 0.75rem 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

/* Logo */
.site-logo {
  display: flex;
  align-items: center;
  text-decoration: none;
  flex-shrink: 0;
}
.site-logo img,
.site-logo svg {
  height: 60px;
  width: auto;
}

/* Top nav */
.top-nav { display: flex; gap: 1.5rem; align-items: center; }
.top-nav a {
  font-size: 0.85rem;
  font-weight: 500;
  color: rgba(58, 74, 85, 0.8);
  text-decoration: none;
  transition: color 0.25s;
  padding: 0.25rem 0;
  border-bottom: 2px solid transparent;
}
.top-nav a:hover,
.top-nav a:focus { color: #3a4a55; outline: none; border-bottom-color: #5fb8c4; }
.top-nav a[aria-current="page"] { color: #6b3fa0; font-weight: 700; border-bottom-color: #6b3fa0; }

/* Hamburger (mobile) */
#navToggle {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  font-size: 1.5rem;
  padding: 0.4rem 0.6rem;
  color: #3a4a55;
  border-radius: 0.25rem;
}
#navToggle:focus { outline: 2px solid #5fb8c4; outline-offset: 2px; }

/* ===== PAGE WRAPPER ===== */
.page-wrapper {
  display: flex;
  flex: 1;
}

/* ===== SIDEBAR NAV ===== */
.sidebar-nav {
  position: fixed;
  top: calc(2.1rem + 75px); /* tagline + header heights */
  left: 0;
  width: 160px;
  height: calc(100vh - 2.1rem - 75px);
  overflow-y: auto;
  background: rgba(243, 247, 250, 0.97);
  border-right: 1px solid #d8e3eb;
  z-index: 30;
  padding: 1.5rem 0;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}
.sidebar-nav a {
  display: block;
  padding: 0.65rem 1.25rem;
  font-size: 0.875rem;
  font-weight: 500;
  color: rgba(58, 74, 85, 0.8);
  text-decoration: none;
  border-left: 3px solid transparent;
  transition: background 0.2s, color 0.2s, border-color 0.2s;
}
.sidebar-nav a:hover,
.sidebar-nav a:focus {
  background: rgba(95, 184, 196, 0.1);
  color: #3a4a55;
  outline: none;
  border-left-color: #5fb8c4;
}
.sidebar-nav a[aria-current="page"] {
  background: rgba(107, 63, 160, 0.08);
  color: #6b3fa0;
  font-weight: 700;
  border-left-color: #6b3fa0;
}

/* ===== MAIN CONTENT ===== */
.main-content {
  margin-left: 160px;
  flex: 1;
  min-width: 0;
  padding: 2rem 1.5rem;
}

main { max-width: 900px; }
main section { margin-bottom: 3rem; }
main h1 { font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem; color: #3a4a55; }
main h1 span { color: #6b3fa0; }
main h2 { font-size: 1.75rem; font-weight: 700; margin-bottom: 1.5rem; color: #3a4a55; }
main h2 span { color: #6b3fa0; }
main p { font-size: 1.125rem; line-height: 1.6; color: rgba(58, 74, 85, 0.9); margin-bottom: 1.5rem; }
main h3 { font-size: 1.25rem; font-weight: 600; color: #3a4a55; }

.hero { padding: 2rem 0; }
.hero p { font-size: 1.25rem; line-height: 1.7; }
.buttons { display: flex; gap: 1rem; margin-top: 2rem; flex-wrap: wrap; }
.primary-btn, .secondary-btn {
  padding: 0.75rem 1.75rem;
  border-radius: 0.5rem;
  font-size: 1rem;
  font-weight: 600;
  text-decoration: none;
  border: none;
  cursor: pointer;
  transition: all 0.3s;
  display: inline-block;
}
.primary-btn {
  background: linear-gradient(90deg, #6b3fa0, #5fb8c4);
  color: #fff;
}
.primary-btn:hover { opacity: 0.9; transform: translateY(-2px); }
.secondary-btn {
  background: rgba(107, 63, 160, 0.1);
  color: #6b3fa0;
  border: 2px solid #6b3fa0;
}
.secondary-btn:hover { background: rgba(107, 63, 160, 0.2); }

.features .grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 2rem;
  margin-top: 2rem;
}
.card {
  background: #fff;
  padding: 1.5rem;
  border-radius: 0.5rem;
  border: 1px solid #d8e3eb;
  transition: all 0.3s;
}
.card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1); }

/* ===== FOOTER ===== */
footer {
  background: #fff;
  border-top: 1px solid #d8e3eb;
  padding: 3rem 1.5rem;
  text-align: center;
  color: rgba(58, 74, 85, 0.6);
  font-size: 0.875rem;
  margin-left: 160px;
  margin-top: auto;
}

/* ===== FOCUS STYLES ===== */
a:focus-visible, button:focus-visible {
  outline: 2px solid #5fb8c4;
  outline-offset: 2px;
}

/* ===== MOBILE ===== */
@media (max-width: 768px) {
  .tagline-banner { font-size: 0.75rem; padding: 0.35rem 0.75rem; }
  .site-header { top: 1.8rem; }

  .top-nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: rgba(243, 247, 250, 0.97);
    border-bottom: 1px solid #d8e3eb;
    flex-direction: column;
    gap: 0;
    padding: 0.5rem 0;
  }
  .top-nav.active { display: flex; }
  .top-nav a { padding: 0.75rem 1.5rem; border-bottom: none; }
  #navToggle { display: block; }

  .sidebar-nav {
    width: 90px;
    top: calc(1.8rem + 68px);
    height: calc(100vh - 1.8rem - 68px);
    padding: 1rem 0;
  }
  .sidebar-nav a {
    font-size: 0.75rem;
    padding: 0.6rem 0.5rem 0.6rem 0.75rem;
    text-align: center;
    border-left: none;
    border-bottom: 2px solid transparent;
  }
  .sidebar-nav a:hover,
  .sidebar-nav a:focus { border-bottom-color: #5fb8c4; }
  .sidebar-nav a[aria-current="page"] { border-bottom-color: #6b3fa0; }

  .main-content { margin-left: 90px; }
  footer { margin-left: 90px; }
  main h1 { font-size: 1.75rem; }
  main h2 { font-size: 1.25rem; }
  .buttons { flex-direction: column; }
  .primary-btn, .secondary-btn { width: 100%; text-align: center; }
}
